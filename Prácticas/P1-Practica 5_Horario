<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Horario 5°J</title>
	<style>
		body {
			font-family: Arial, sans-serif;
			background-color: #f4f6f9;
			color: #333;
			padding: 20px;
		}
		h1 {
			color: #003366; 
			text-align: center;
		}
		table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 20px;
			background-color: #ffffff;
			box-shadow: 0 4px 8px rgba(0,0,0,0.1);
		}
		th, td {
			padding: 12px;
			text-align: center;
			border: 1px solid #dddddd;
		}
		thead th {
			background-color: #003366;
			color: white;
		}
		td:first-child {
			background-color: #f2f2f2;
			font-weight: bold;
		}
		.receso {
			background-color: #e9ecef;
			font-weight: bold;
			letter-spacing: 2px;
			color: #495057;
		}
		/* Colores personalizados para las materias */
		.historia { background-color: #ffcccc; }
		.admin { background-color: #ffe6cc; }
		.ingles { background-color: #e6f2ff; }
		.prog1 { background-color: #d1e7dd; font-weight: bold; }
		.prog2 { background-color: #d1c4e9; font-weight: bold; }
		.ciencias { background-color: #fff3cd; }
		.tutoria { background-color: #e2e3e5; }
		.mate { background-color: #f8d7da; }
	</style>
</head>
<body>

	<h1><strong>Centro de Bachillerato Técnico Industrial y de Servicios No.128</strong></h1>
	
	<table>
		<thead>
			<tr>
				<th>Hora</th> 
				<th>Lunes</th> 
				<th>Martes</th> 
				<th>Miércoles</th> 
				<th>Jueves</th> 
				<th>Viernes</th> 
			</tr>
		</thead>
		<tbody>
			<!-- 7:00 - 8:00 -->
			<tr>
				<td>7:00-8:00</td> 
				<td></td> 
				<td class="historia">Historia</td> 
				<td class="admin">Administración</td> 
				<td class="admin">Administración</td> 
				<td class="ingles">Inglés</td> 
			</tr>		
			<!-- 8:00 - 9:00 -->
			<tr>
				<td>8:00-9:00</td> 
				<td></td> 
				<td class="admin">Administración</td> 
				<td class="historia">Historia</td> 
				<td class="ingles">Inglés</td> 
				<td class="historia">Historia</td> 
			</tr>		
			<!-- 9:00 - 10:00 -->
			<tr>
				<td>9:00-10:00</td> 
				<td class="ingles">Inglés</td> 
				<td class="prog1" rowspan="2">PROG M4S1</td> 
				<td class="prog1" rowspan="2">PROG M4S1</td> <!-- Se agregó rowspan para alinear el Miércoles -->
				<td class="prog1" rowspan="2">PROG M4S1</td> 
				<td class="prog1" rowspan="2">PROG M4S1</td> 
			</tr>
			<!-- 10:00 - 10:50 -->
			<tr>
				<td>10:00-10:50</td> 
				<td class="ciencias">Ciencias</td> 
				<!-- Martes se salta -->
				<!-- Miércoles se salta -->
				<!-- Jueves se salta -->
				<!-- Viernes se salta -->
			</tr>
			
			<!-- Fila de Receso (Limpia sin desborde) -->
			<tr>
				<td colspan="6" class="receso">10:50 - 11:10 | RECESO</td>
			</tr>

			<!-- 11:10 - 12:00 -->
			<tr>
				<td>11:10-12:00</td> 
				<td class="prog2">PROG M4S2</td> 
				<td class="prog2">PROG M4S2</td> 
				<td class="ciencias" rowspan="2">Ciencias</td> 
				<td class="prog2" rowspan="2">PROG M4S2</td> 
				<td class="ciencias">Ciencias</td> 
			</tr>
			<!-- 12:00 - 1:00 -->
			<tr>
				<td>12:00-1:00</td> 
				<td class="tutoria">Tutoría</td> 
				<td class="ingles">Inglés</td> 
				<!-- Miércoles se salta -->
				<!-- Jueves se salta -->
				<td class="prog2">PROG M4S2</td> 
			</tr>
			<!-- 1:00 - 2:00 -->
			<tr>
				<td>1:00-2:00</td> 
				<td class="mate">Matemáticas</td> 
				<td class="mate">Matemáticas</td> 
				<td class="mate">Matemáticas</td> 
				<td class="mate">Matemáticas</td> 
				<td class="mate">Matemáticas</td> 
			</tr>
		</tbody>
	</table>

</body>
</html>
